# Directory Authority.
ORPort 9001
DirPort 9030
SocksPort 0

AuthoritativeDirectory 1
V3AuthoritativeDirectory 1
ContactInfo lab-admin@gotor.tor

# NO exit.
ExitRelay 0
ExitPolicy reject *:*

# Vote and publish very often (20 sec on startup, 60 seconds when started).
TestingV3AuthInitialVotingInterval 20
TestingV3AuthInitialVoteDelay 4
TestingV3AuthInitialDistDelay 4
TestingV3AuthVotingStartOffset 0
V3AuthVotingInterval 60
V3AuthVoteDelay 4
V3AuthDistDelay 4
